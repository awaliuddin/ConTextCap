[flake8]
# Flake8 configuration for ConTextCap

max-line-length = 88
extend-ignore = E203, W503, E501
max-complexity = 10
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .eggs,
    *.egg,
    build,
    dist,
    .pytest_cache,
    .mypy_cache,
    htmlcov,
    .tox

per-file-ignores =
    __init__.py: F401
    tests/*: D100, D101, D102, D103

# Error codes
select = C,E,F,W,B,B950

# McCabe complexity
max-complexity = 10
